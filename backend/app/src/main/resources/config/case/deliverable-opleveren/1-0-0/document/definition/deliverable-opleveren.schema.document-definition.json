{
    "$id": "deliverable-opleveren.schema",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Deliverable Opleveren",
    "type": "object",
    "properties": {
        "deliverableTitle": {
            "type": "string",
            "description": "Titel van de deliverable"
        },
        "deliverableId": {
            "type": "string",
            "description": "ID van de aangemaakte deliverable"
        },
        "deliverableStatus": {
            "type": "string",
            "description": "Status van de deliverable"
        },
        "projectKey": {
            "type": "string",
            "description": "Key van het project"
        },
        "opmerking": {
            "type": "string",
            "description": "Opmerking bij de oplevering"
        },
        "goedgekeurd": {
            "type": "boolean",
            "description": "Is de deliverable goedgekeurd?"
        }
    }
}
