{
    "$id": "sales-deliverable-opgeleverd.schema",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Sales - Deliverable Opgeleverd",
    "type": "object",
    "properties": {
        "deliverable": {
            "type": "object",
            "properties": {
                "id": { "type": "string" },
                "version": { "type": "integer" },
                "title": { "type": "string" },
                "status": { "type": "string" },
                "projectId": { "type": ["string", "null"] }
            }
        },
        "besluit": {
            "type": "object",
            "properties": {
                "aanpassingNodig": { "type": "boolean" },
                "toelichting": { "type": "string" }
            }
        }
    }
}
