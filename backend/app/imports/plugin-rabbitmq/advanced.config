[
  {rabbitmq_shovel, [
    {shovels, [
      {'mdh-to-local', [
        {source, [
          {protocol, amqp091},
          {uris, ["amqp://guest:guest@host.docker.internal:5673"]},
          {declarations, [
            {'exchange.declare', [{exchange, <<"masterdata-events">>}, {type, <<"fanout">>}, durable]},
            {'queue.declare', [{queue, <<"shovel-mdh-to-local">>}, durable]},
            {'queue.bind', [{queue, <<"shovel-mdh-to-local">>}, {exchange, <<"masterdata-events">>}]}
          ]},
          {queue, <<"shovel-mdh-to-local">>}
        ]},
        {destination, [
          {protocol, amqp091},
          {uris, ["amqp://"]},
          {declarations, []},
          {publish_properties, [{delivery_mode, 2}]},
          {exchange, <<"masterdata-events">>}
        ]},
        {ack_mode, on_confirm},
        {reconnect_delay, 5}
      ]}
    ]}
  ]}
].
